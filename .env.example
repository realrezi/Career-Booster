# Copy this file to .env and fill in your own keys.
# .env is git-ignored, so your real keys never leave your machine.
#
# Google AI Studio key (preferred, fastest path): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter key (fallback models): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
